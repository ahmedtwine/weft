setup {
  person "acme_admin"
  person "acme_analyst"
  api "admin" credential_ref="/acme/warehouse" {
    on "set_credential" credential_ref=(next)"admin.credential_ref"
  }
  api "tool" tenant="acme" {
    on "query" tenant=(next)"tool.tenant"
  }
  api "authz"
  api "vault" read_owner="" {
    invariant "a credential is read only for its own tenant" {
      implies {
        neq "vault.read_owner" ""
        eq "vault.read_owner" "tool.tenant"
      }
    }
  }
}
action {
  set_credential from="acme_admin" to="admin"
  query from="acme_analyst" to="tool"
}
impl "authz" {
  module "authz" "../../apps/authz/authz/authz.go"
  serve "authz.url"
  start "authz.reset"
  read "authz.authz" output="authz.authzSchema"
}
impl "vault" {
  module "vault" "../../apps/vault/src/vault.rs"
  serve "vault.url"
  start "vault.reset"
  read "vault.vault" output="vault.vaultSchema"
}
impl "admin" {
  module "admin" "../../apps/admin/admin.py"
  start "admin.provision"
  read "admin.read" output="admin.stateSchema"
  run "admin.set_credential" input="admin.setCredentialSchema"
}
impl "tool" {
  module "tool" "../../apps/tool/tool.ts"
  read "tool.state" output="tool.stateSchema"
  run "tool.query" input="tool.querySchema"
}
