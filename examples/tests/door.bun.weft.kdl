setup {
  person "user"
  device "door" {
    invariant "an error only when locked" {
      implies {
        neq "door.error" ""
        eq "door.state" "locked"
      }
    }
  }
}
impl "bun" {
  module "door" "../runners/bun/door/door.ts"
  start "door.reset"
  run "door.open"
  run "door.close"
  run "door.lock"
  run "door.unlock"
}
