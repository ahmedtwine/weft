setup {
  person "ana"
  person "dispatcher"
  api "shop"
  api "courier" {
    invariant "a parcel goes only to the address of its own customer" {
      forall "p" in="courier.parcels" {
        eq "p.customer" "p.recipient"
      }
    }
  }
  api "orders"
  api "addresses"
}
impl "go" {
  module "orders" "../runners/go/parcel/orders.go"
  serve "orders.url"
  start "orders.reset"
}
impl "rust" {
  module "addresses" "../runners/rust/parcel/addresses.rs"
  serve "addresses.url"
  start "addresses.reset"
}
impl "python" {
  module "shop" "../runners/python/parcel/shop.py"
  start "shop.open_shop"
  run "shop.choose_address" input="shop.chooseAddressSchema" by="ana"
}
impl "bun" {
  module "courier" "../runners/bun/parcel/courier.ts"
  start "courier.reset"
  run "courier.ship" input="courier.shipSchema" by="dispatcher"
}
