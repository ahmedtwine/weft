include "**/*.weft.kdl"
theme "light"
style "person" icon="user"
style "element" icon="door-closed"
style "api" icon="server"
adapter "bun" cases=100
runner "rust" command="runners/rust/target/release/door"
runner "go" command="runners/go/bin/door"
runner "python" command="uv run --quiet --project runners/python python -m weft"
runner "authz" command="apps/authz/bin/authz"
runner "vault" command="apps/vault/target/release/vault"
runner "admin" command="uv run --quiet --project runners/python python -m weft"
runner "tool" harness="bun"
