golden "vague" {
    cut "function_item" "struct_item"
    question "Which kind of word is the name of the item in `text`?"
    flag role="a word for a role, a category or an act that fits any program, where a word for what the item holds or computes could stand"
    pass concrete="a word for what the item holds or computes: a noun such as temperature or invoice, or a verb such as sort or divide" check="a verb that says what the function checks, such as contains or matches"
    fix "rename"
}

golden "layer" {
    cut "function_item"
    question "Which job does the function in `text` do in `context`?"
    flag wrapper="a wrapper that forwards to one other call and adds only a new name"
    pass logic="a function with its own computation" boundary="a function that converts input, output or errors at the edge of the program"
    fix "inline"
}

golden "alias" {
    cut "const_item" "let_declaration"
    question "Which kind of name does `text` declare, given each other name in `context`?"
    flag synonym="a name with the same meaning as another name in `context`, for the same object"
    pass unique="a name with a meaning that differs from each other name in `context`"
    fix "rename"
}

golden "comment" {
    cut "line_comment"
    question "Which job does the comment in `text` do for a reader of the code?"
    flag echo="a comment that restates what the next line of code says"
    pass reason="a comment that gives a reason or a fact that the code leaves out"
    fix "remove"
}
