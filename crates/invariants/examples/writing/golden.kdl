golden "negation" {
    cut "not" "no" "never" "nothing" "none" "nobody" "nowhere" "nor" "neither" "cannot" "without" "unless" "don't" "doesn't" "didn't" "isn't" "aren't" "wasn't" "weren't" "won't" "can't" "couldn't" "wouldn't" "shouldn't" "haven't" "hasn't" "hadn't"
    question "Which job does the denial in `text` do for the reader of `context`?"
    flag invented="a denial of a claim, fear or wish that the writer invents to deny it" nonevent="a report by the writer of an action that the writer skipped or of work that is absent" fragment="a fragment that lists an absent thing, such as No X." status="a status of the work that names what fails in place of what happens" pitch="a pitch that defines the product or its users by what they reject" hedge="a phrase of the form A without being B, which denies a fault that only the writer raises" cliche="a stock denial that praises, such as did not disappoint or can't wait" reassure="a reassurance about a risk that only the writer raises"
    pass warning="a prohibition or a warning to the reader" rule="a rule, limit or requirement that the reader needs to act" condition="a condition on the input, with if, unless, until, or a clause such as that have no X" error="the meaning of an error or of a missing item" correction="a correction of an expectation that `text` names before the denial, such as you expected X, but" lack="a feature that the product lacks, with the step the reader takes instead" fact="a plain fact about the world outside the work of the writer: a limit, an error, a failure or a past state"
    split contrast="a sentence that denies one side and affirms a replacement side"
    then {
        question "In the contrast in `text`, what is the side that the writer affirms?"
        flag label="a label, a judgment, a vague amount or an abstract noun phrase on the affirmed side" party="a party on the denied side that only the writer brings up"
        pass concrete="a concrete place, person, object, number, quantity or event"
    }
}

golden "actor" {
    question "Which pairing of subject and verb does `text` hold?"
    flag animate="a thing, a program or an idea as the subject of a verb for a mind or a body: decide, want, know, believe, care, dwell, watch, reveal"
    pass person="a person or a group of people, such as staff or a team, as the subject of each verb" mechanical="a thing or a program as the subject of a verb for a mechanical act: store, read, return, reset, skip, run" none="a command, a fragment or a copula with be"
}

golden "vague" {
    question "Which kind of noun carries the main claim of `text`?"
    flag figure="a figure of speech or a noun for a quality or a feeling, which stands where the writer could name a thing the reader can point at, count or run"
    pass concrete="a noun for a thing the reader can point at, count or run: a person, a place, a file, a number, a command, a price, an event" judgment="a plain judgment of a concrete thing, such as good, slow or expensive"
}
